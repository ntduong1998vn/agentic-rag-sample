# Voyage AI API Configuration
# Get your API key from: https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Qdrant Configuration
# These are the default values for local Docker setup
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_documents
QDRANT_API_KEY=your_qdrant_api_key_here  # Optional for local setup

# Semantic Chunking Configuration
# These control how documents are split into chunks
SEMANTIC_BREAKPOINT_PERCENTILE_THRESHOLD=90
SEMANTIC_BUFFER_SIZE=1
SEMANTIC_MAX_TOKENS_PER_CHUNK=800
SEMANTIC_TOKEN_OVERLAP=50

# GitLab Configuration
# For code repository ingestion via GitLab API
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_personal_access_token_here
GITLAB_PROJECT_ID=your_project_id_here

# Code Chunking Configuration
# These control how code files are split into AST-based chunks
CODE_CHUNKING_MIN_TOKENS=100
CODE_CHUNKING_MAX_TOKENS=2000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log
LOG_CONSOLE=true
